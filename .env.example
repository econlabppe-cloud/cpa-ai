# העתיקו ל-.env והגדירו. python -m cpa_ai אינו טוען .env לבד; השתמשו ב-`set -a; . ./.env; set +a`.

# ── חובה ──────────────────────────────────────────
CPA_AI_API_KEY=change-me                 # מפתח משותף (מנהל)
# או משתמשים עם תפקיד והרשאה לפי עסק (מומלץ; השם ביומן נגזר מהמפתח):
# CPA_AI_USERS='{"k-admin":"מנהל","k-acc":{"name":"רו\"ח ישראלה","role":"accountant","businesses":[1,2]},"k-dana":{"name":"דנה","role":"client","businesses":[1]}}'
CPA_AI_DATABASE_URL=sqlite:///./cpa_ai.db
CPA_AI_DATA_DIR=./cpa_ai_data            # כאן נשמרים קבצי המקור (חשבוניות). לגבות!

# ── מייל (אחת משתי הדרכים) ─────────────────────────
# א) תיבת IMAP (למשל Gmail עם סיסמת אפליקציה). ניתוב לעסק לפי inbox+TOKEN@...
CPA_AI_IMAP_HOST=imap.gmail.com
CPA_AI_IMAP_USER=your.address@gmail.com
CPA_AI_IMAP_PASSWORD=app-password
CPA_AI_IMAP_INTERVAL=120
# CPA_AI_IMAP_DEFAULT_BUSINESS=1         # ⚠️ רק לתיבה ייעודית לחשבוניות: כל הודעה בתיבה תיכנס לעסק הזה
# ב) ספק דואר נכנס (Mailgun/Postmark/SendGrid) שמעביר ל-POST /api/v1/inbound/email
# CPA_AI_INBOUND_EMAIL_DOMAIN=inbox.example.com

# ── WhatsApp Cloud API (Meta) ─────────────────────
# CPA_AI_WHATSAPP_APP_SECRET=            # סוד האפליקציה (לאימות חתימת webhook) — חובה כדי שה-webhook יעבוד
# CPA_AI_WHATSAPP_VERIFY_TOKEN=          # מחרוזת שתבחרו, גם תוזן בהגדרות ה-webhook ב-Meta
# CPA_AI_WHATSAPP_TOKEN=                 # טוקן גישה — להורדת מדיה ולשליחת תשובות
# CPA_AI_WHATSAPP_GRAPH_VERSION=v21.0

# ── קריאת מסמכים ──────────────────────────────────
# OCR מקומי (מומלץ, בלי לשלוח החוצה): apt install tesseract-ocr tesseract-ocr-heb poppler-utils
# CPA_AI_OCR=off                         # כיבוי OCR
# CPA_AI_OCR_LANGS=heb+eng
# בינה מלאכותית (אופציונלי; רק לעסק שנתן הסכמה). Claude קורא גם PDF סרוק:
# ANTHROPIC_API_KEY=
# CPA_AI_CLAUDE_MODEL=claude-opus-5-5
# CPA_AI_LLM_PROVIDER=auto               # auto | claude | openai
# OPENAI_API_KEY=
# CPA_AI_OPENAI_MODEL=gpt-4o

# ── התראות ללקוח ולרו"ח (אופציונלי) ─────────────────
# CPA_AI_WHATSAPP_PHONE_NUMBER_ID=       # המספר השולח ב-WhatsApp Cloud API
# CPA_AI_SMTP_HOST=smtp.gmail.com
# CPA_AI_SMTP_PORT=587
# CPA_AI_SMTP_USER=
# CPA_AI_SMTP_PASSWORD=
# CPA_AI_SMTP_FROM=
# CPA_AI_ACCOUNTANT_EMAIL=office@example.com   # לאן להודיע כשלקוח עונה
# CPA_AI_PUBLIC_URL=https://cpa.example.com    # קישור בהודעות

# ── הזרמת תנועות בנק/אשראי (אופציונלי) ──────────────
# CPA_AI_TX_WEBHOOK_SECRET=              # סוד HMAC ל-POST /api/v1/inbound/transactions/{token}

# ── פיתוח מקומי בלבד ──────────────────────────────
# CPA_AI_ALLOW_INSECURE=1                # ללא מפתח API. לא לפריסה.

# ── אבטחה ─────────────────────────────────────────
# CPA_AI_ENCRYPTION_KEY=                 # python -m cpa_ai gen-key. כמה מפתחות מופרדים בפסיק = רוטציה (הראשון מצפין)
# CPA_AI_TRUST_PROXY=1                   # רק מאחורי פרוקסי אמין: מכבד X-Forwarded-For להגבלת קצב
