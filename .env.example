# העתיקו ל-.env והגדירו. python -m cpa_ai אינו טוען .env לבד; השתמשו ב-`set -a; . ./.env; set +a`.

# ── חובה ──────────────────────────────────────────
CPA_AI_API_KEY=change-me                 # או CPA_AI_USERS='{"מפתח-דנה":"דנה","מפתח-רוח":"רו\"ח ישראלה"}' (שם ביומן לפי מפתח)
CPA_AI_DATABASE_URL=sqlite:///./cpa_ai.db
CPA_AI_DATA_DIR=./cpa_ai_data            # כאן נשמרים קבצי המקור (חשבוניות). לגבות!

# ── מייל (אחת משתי הדרכים) ─────────────────────────
# א) תיבת IMAP (למשל Gmail עם סיסמת אפליקציה). ניתוב לעסק לפי inbox+TOKEN@...
CPA_AI_IMAP_HOST=imap.gmail.com
CPA_AI_IMAP_USER=your.address@gmail.com
CPA_AI_IMAP_PASSWORD=app-password
CPA_AI_IMAP_INTERVAL=120
# CPA_AI_IMAP_DEFAULT_BUSINESS=1         # ⚠️ רק לתיבה ייעודית לחשבוניות: כל הודעה בתיבה תיכנס לעסק הזה
# ב) ספק דואר נכנס (Mailgun/Postmark/SendGrid) שמעביר ל-POST /api/v1/inbound/email
# CPA_AI_INBOUND_EMAIL_DOMAIN=inbox.example.com

# ── WhatsApp Cloud API (Meta) ─────────────────────
# CPA_AI_WHATSAPP_APP_SECRET=            # סוד האפליקציה (לאימות חתימת webhook) — חובה כדי שה-webhook יעבוד
# CPA_AI_WHATSAPP_VERIFY_TOKEN=          # מחרוזת שתבחרו, גם תוזן בהגדרות ה-webhook ב-Meta
# CPA_AI_WHATSAPP_TOKEN=                 # טוקן גישה — להורדת מדיה ולשליחת תשובות
# CPA_AI_WHATSAPP_GRAPH_VERSION=v21.0

# ── חילוץ בעזרת AI (אופציונלי; רק לעסק שנתן הסכמה) ───
# OPENAI_API_KEY=
# CPA_AI_OPENAI_MODEL=gpt-4o

# ── פיתוח מקומי בלבד ──────────────────────────────
# CPA_AI_ALLOW_INSECURE=1                # ללא מפתח API. לא לפריסה.
